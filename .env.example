# ============================================================================
# Automotive Supply Chain AI System - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED: Qdrant Cloud Configuration
# ----------------------------------------------------------------------------
# Get these from your Qdrant Cloud dashboard: https://cloud.qdrant.io
# Format: https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.us-west-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# ----------------------------------------------------------------------------
# REQUIRED: OpenAI API Key
# ----------------------------------------------------------------------------
# Required for CrewAI agents to function
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ----------------------------------------------------------------------------
# OPTIONAL: Collection Configuration
# ----------------------------------------------------------------------------
# Name of the Qdrant collection (default: automotive_parts)
COLLECTION_NAME=automotive_parts

# ----------------------------------------------------------------------------
# OPTIONAL: Embedding Model Configuration
# ----------------------------------------------------------------------------
# Sentence transformer model for generating embeddings
# Default: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector dimension size (must match embedding model)
# Default: 384 (for all-MiniLM-L6-v2)
VECTOR_SIZE=384

# ----------------------------------------------------------------------------
# OPTIONAL: Qdrant 1.16 Feature Settings
# ----------------------------------------------------------------------------

# Enable ACORN algorithm for improved recall on restrictive filters
# Default: true
ACORN_ENABLED=true

# ACORN activation threshold (selectivity: 0.0 to 1.0)
# Lower values = ACORN activates more frequently
# Default: 0.4
ACORN_MAX_SELECTIVITY=0.4

# Enable tiered multitenancy for tenant data isolation
# Default: true
ENABLE_MULTITENANCY=true

# Number of shards for distributing tenant data
# More shards = better parallelism but more resources
# Default: 3
SHARD_NUMBER=3

# ============================================================================
# Setup Instructions:
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and replace placeholder values with your actual credentials
# 3. Never commit .env to version control (it's in .gitignore)
# ============================================================================
